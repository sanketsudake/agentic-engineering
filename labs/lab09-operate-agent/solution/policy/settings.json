{
  "permissions": {
    "deny": [
      "Bash(rm -rf*)",
      "Bash(git push --force*)",
      "Read(.env)"
    ],
    "ask": [
      "Bash(npm install -g*)",
      "Bash(pip install --user*)",
      "Edit(/etc/*)"
    ],
    "allow": [
      "Bash(git status)",
      "Bash(pytest -q)",
      "Read(src/*)",
      "Edit(src/*)"
    ]
  }
}
